---
import Layout from '../layouts/Layout.astro';
import KitCard from '../components/KitCard.astro';
import SiteNav from '../components/SiteNav.astro';
import { kits } from '../data/kits';

const emptySlots = Math.max(0, 5 - kits.length);
---

<Layout title="RSI — Kit Instructions">
	<header class="header">
		<div class="header-inner">
			<p class="wordmark">RSI</p>
			<p class="tagline">Kit instructions &amp; blueprints</p>
			<SiteNav current="home" />
		</div>
	</header>

	<main class="main">
		<div class="search-wrap">
			<input
				id="search"
				class="search"
				type="search"
				placeholder="Search kits..."
				aria-label="Search kits"
			/>
		</div>

		<p id="empty-message" class="empty-message" hidden>
			No kits match your search. Check the spelling or clear the search to browse all kits.
		</p>

		<div id="grid" class="grid">
			{kits.map((kit, i) => <KitCard kit={kit} featured={i === 0} />)}
			{Array.from({ length: emptySlots }).map(() => <KitCard />)}
		</div>
	</main>

	<footer id="footer" class="footer">
		<p>Bought a kit? Find it above for the full build.</p>
	</footer>
</Layout>

<script>
	const NUMBER_WORDS: Record<string, string> = {
		zero: '0',
		one: '1',
		two: '2',
		three: '3',
		four: '4',
		five: '5',
		six: '6',
		seven: '7',
		eight: '8',
		nine: '9',
		ten: '10',
	};

	function normalizeSearch(value: string): string {
		return value
			.toLowerCase()
			.replace(/\b(zero|one|two|three|four|five|six|seven|eight|nine|ten)\b/g, (word) => NUMBER_WORDS[word])
			.replace(/\bby\b/g, 'x')
			.replace(/[^a-z0-9]+/g, '');
	}

	const input = document.getElementById('search') as HTMLInputElement;
	const grid = document.getElementById('grid') as HTMLElement;
	const emptyMessage = document.getElementById('empty-message') as HTMLElement;
	const footer = document.getElementById('footer') as HTMLElement;
	const slots = Array.from(grid.querySelectorAll<HTMLElement>('.slot[data-kit-name]')).map((slot) => ({
		el: slot,
		normalizedName: normalizeSearch(slot.dataset.kitName ?? ''),
	}));

	input.addEventListener('input', () => {
		const query = normalizeSearch(input.value.trim());
		let visibleCount = 0;

		for (const slot of slots) {
			const matches = slot.normalizedName.includes(query);
			slot.el.hidden = !matches;
			if (matches) visibleCount++;
		}

		const ghostSlots = grid.querySelectorAll<HTMLElement>('.slot-empty');
		ghostSlots.forEach((slot) => {
			slot.hidden = input.value.trim().length > 0;
		});

		const noResults = input.value.trim().length > 0 && visibleCount === 0;
		emptyMessage.hidden = !noResults;
		footer.hidden = noResults;
	});
</script>

<style>
	.header {
		background: linear-gradient(180deg, var(--wood-light) 0%, var(--wood) 60%, var(--wood-dark) 100%);
		border-bottom: 4px solid var(--wood-dark);
		padding: 2.25rem 1.5rem 1.75rem;
	}

	.header-inner {
		max-width: 1120px;
		margin: 0 auto;
		text-align: center;
	}

	.wordmark {
		font-family: var(--font-display);
		font-size: clamp(2.75rem, 6vw, 4rem);
		font-weight: 600;
		margin: 0;
		color: var(--text-light);
		letter-spacing: 0.04em;
		animation: header-in 0.5s ease;
	}

	.tagline {
		margin: 0.5rem 0 0;
		font-family: var(--font-body);
		font-size: 1.25rem;
		color: rgba(244, 239, 223, 0.75);
		animation: header-in 0.5s ease 0.08s backwards;
	}

	@keyframes header-in {
		from {
			opacity: 0;
			transform: translateY(-8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.main {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 3rem;
	}

	.search-wrap {
		display: flex;
		justify-content: center;
		margin-bottom: 2.5rem;
	}

	.search {
		width: 100%;
		max-width: 620px;
		font-family: var(--font-body);
		font-size: 1.25rem;
		padding: 1.1rem 1.4rem;
		background: var(--stone-darker);
		color: var(--text-light);
		border-top: 2px solid var(--stone-darker);
		border-left: 2px solid var(--stone-darker);
		border-right: 2px solid var(--stone-light);
		border-bottom: 2px solid var(--stone-light);
	}

	.search::placeholder {
		color: var(--text-dim);
	}

	.search {
		transition:
			background-color 0.3s ease,
			border-color 0.3s ease,
			outline-color 0.2s ease,
			outline-offset 0.2s ease;
		outline: 2px solid transparent;
		outline-offset: 0;
	}

	.search:focus {
		outline: 2px solid var(--lantern);
		outline-offset: 2px;
	}

	.empty-message {
		text-align: center;
		color: var(--page-muted);
		font-family: var(--font-body);
		font-size: 1.1rem;
		margin: -1rem 0 2rem;
	}

	.empty-message:not([hidden]) {
		animation: header-in 0.3s ease;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1.5rem;
	}

	.footer {
		text-align: center;
		padding: 1.5rem 1.5rem 1rem;
		color: var(--page-muted);
		font-family: var(--font-body);
		font-size: 1.1rem;
	}
</style>
