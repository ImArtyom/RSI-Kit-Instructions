---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ShulkerIcon from '../../components/ShulkerIcon.astro';
import { kits } from '../../data/kits';
import { getKitStepImage } from '../../data/kitImages';

export function getStaticPaths() {
	return kits.map((kit) => ({
		params: { slug: kit.slug },
		props: { kit },
	}));
}

const { kit } = Astro.props;
const previewImage = getKitStepImage(kit.slug, kit.steps.length);
---

<Layout title={`${kit.name} — RSI`}>
	<header class="header">
		<div class="header-inner">
			<a class="back" href="/">&lsaquo; All kits</a>
		</div>
	</header>

	<main class="main">
		<div class="preview">
			<div class="preview-image">
				<Image src={previewImage} alt={`Finished ${kit.name} build`} width={900} height={506} />
			</div>

			<div class="preview-info">
				<div>
					<div class="title-row">
						<ShulkerIcon color={kit.color} size={64} />
						<div>
							<p class="number">#{kit.number}</p>
							<h1 class="name">{kit.name}</h1>
						</div>
					</div>
					<p class="summary">{kit.summary}</p>
					<p class="price">
						<span class="price-icon" aria-hidden="true"></span>
						{kit.price} Gold Ingots
					</p>
				</div>

				<a class="instructions-button" href={`/kits/${kit.slug}/instructions`}>
					Instructions
				</a>
			</div>
		</div>
	</main>
</Layout>

<style>
	.header {
		background: linear-gradient(180deg, var(--wood-light) 0%, var(--wood) 60%, var(--wood-dark) 100%);
		border-bottom: 4px solid var(--wood-dark);
		padding: 1.5rem;
	}

	.header-inner {
		max-width: 1800px;
		width: 94%;
		margin: 0 auto;
	}

	.back {
		display: inline-block;
		font-family: var(--font-body);
		font-size: 1.1rem;
		color: rgba(244, 239, 223, 0.75);
		text-decoration: none;
	}

	.back:hover {
		color: var(--text-light);
	}

	.main {
		max-width: 1800px;
		width: 94%;
		margin: 0 auto;
		padding: 2.5rem 0 3rem;
		min-height: calc(100vh - 260px);
		display: flex;
		align-items: stretch;
	}

	.preview {
		width: 100%;
	}

	.preview {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		gap: 3rem;
		background: var(--stone);
		border-top: 3px solid var(--stone-light);
		border-left: 3px solid var(--stone-light);
		border-right: 3px solid var(--stone-darker);
		border-bottom: 3px solid var(--stone-darker);
		padding: 3rem;
		animation: preview-in 0.45s ease;
	}

	.preview-image {
		background: var(--stone-darker);
		border: 2px solid var(--stone-dark);
		box-shadow: inset 2px 2px 0 #000;
		overflow: hidden;
		display: flex;
	}

	.preview-image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.5s ease;
	}

	.preview-image:hover :global(img) {
		transform: scale(1.04);
	}

	@keyframes preview-in {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.preview-info {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 2rem;
	}

	.title-row {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.number {
		font-family: var(--font-display);
		font-size: 1.05rem;
		margin: 0;
		color: var(--text-dim);
	}

	.name {
		font-family: var(--font-display);
		font-size: clamp(1.8rem, 3.6vw, 2.5rem);
		margin: 0.2rem 0 0;
		color: var(--text-light);
	}

	.summary {
		margin: 1.5rem 0 0;
		font-size: 1.25rem;
		color: var(--text-light);
		line-height: 1.6;
	}

	.price {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 1.75rem 0 0;
		font-family: var(--font-display);
		font-size: 1.2rem;
		color: var(--lantern);
	}

	.price-icon {
		width: 26px;
		height: 16px;
		background: linear-gradient(180deg, #fff3ad 0%, #f4d35b 40%, #d9a520 100%);
		border-top: 1px solid #fff9d6;
		border-left: 1px solid #fff9d6;
		border-right: 1px solid #a97c14;
		border-bottom: 1px solid #a97c14;
	}

	.instructions-button {
		align-self: flex-start;
		font-family: var(--font-display);
		font-size: 1.1rem;
		text-decoration: none;
		color: var(--text-dark);
		padding: 1rem 2rem;
		background: var(--lantern);
		border-top: 2px solid #ffd489;
		border-left: 2px solid #ffd489;
		border-right: 2px solid var(--lantern-dark);
		border-bottom: 2px solid var(--lantern-dark);
		transition:
			background-color 0.15s ease,
			transform 0.1s ease;
	}

	.instructions-button:hover {
		background: #ffbe57;
		transform: translateY(-2px);
	}

	.instructions-button:active {
		border-top-color: var(--lantern-dark);
		border-left-color: var(--lantern-dark);
		border-right-color: #ffd489;
		border-bottom-color: #ffd489;
		transform: translateY(0);
	}

	@media (max-width: 720px) {
		.preview {
			grid-template-columns: 1fr;
		}

		.preview-image {
			aspect-ratio: 16 / 9;
		}

		.instructions-button {
			align-self: stretch;
			text-align: center;
		}
	}
</style>
